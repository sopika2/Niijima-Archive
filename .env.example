# Copy to .env next to compose.yml and fill in. Never commit .env.

# ── Sign-in (shared across the Niijima Network) ──────────────────────────────
# Discord sign-in (https://discord.com/developers/applications → the app you already use for
# Treasure → OAuth2). Add this exact Redirect there:  https://archive.niijimasisters.com/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs login cookies. Use the SAME value in every Niijima app (openssl rand -hex 32), together
# with SESSION_DOMAIN below, and signing in once covers every subdomain.
SESSION_SECRET=
# The parent domain the sign-in cookie is shared on. Leave empty to keep it to this app only.
SESSION_DOMAIN=niijimasisters.com
# The address you open the app at, without a trailing slash. compose.yml also passes it to the
# server as ORIGIN, which it needs behind Traefik and the tunnel.
PUBLIC_URL=https://archive.niijimasisters.com
# "discord" (default) or "off". Only use "off" on your own machine.
ACCESS_MODE=discord

# ── Saving from the iPhone (iOS Shortcut) ────────────────────────────────────
# Token for POST /api/save (Authorization: Bearer <token>). At least 24 characters:
#   openssl rand -hex 32        Leave empty to turn the endpoint off.
SAVE_TOKEN=

# ── Mementos (optional) ──────────────────────────────────────────────────────
# Your Zipline. When both are set, saved pictures get a "Copy Mementos link" button.
# The token is in Zipline → your avatar → Copy token.
ZIPLINE_URL=https://mementos.niijimasisters.com
ZIPLINE_TOKEN=

# ── Server setup (used by compose.yml) ───────────────────────────────────────
# Public address Traefik routes to the app.
APP_HOST=archive.niijimasisters.com
# The Docker network Traefik listens on, and its entrypoint name.
TRAEFIK_NETWORK=zipline_default
TRAEFIK_ENTRYPOINT=web
# User and group the app runs as; ./data must be writable by them (id -u, id -g).
PUID=1000
PGID=1000
# Largest request the server accepts (a share from the phone with many pictures). Keep it above
# media.max_upload_mb in config.yml.
BODY_SIZE_LIMIT=256M
