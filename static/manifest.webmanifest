{
	"id": "/",
	"name": "Thieves Den · Niijima Archive",
	"short_name": "Thieves Den",
	"description": "Everything you've stolen: tweets and pictures, with your own captions.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#0b0b0d",
	"theme_color": "#0b0b0d",
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{
			"src": "/icons/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
	],
	"share_target": {
		"action": "/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "media",
					"accept": [
						"image/*",
						"video/*",
						".jpg",
						".jpeg",
						".png",
						".gif",
						".webp",
						".mp4",
						".webm",
						".mov"
					]
				}
			]
		}
	}
}
